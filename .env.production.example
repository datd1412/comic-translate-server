# Production database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:change_me@127.0.0.1:5432/comic_translate

# Security
SECRET_KEY=change_this_to_a_long_random_secret
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# CORS
CORS_ALLOW_ORIGINS=https://your-domain.com
CORS_ALLOW_CREDENTIALS=true
ENABLE_SECURITY_HEADERS=true
ENABLE_HSTS=true

# Admin
ADMIN_EMAILS=admin@example.com

# PayOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://your-domain.com/billing/v1/payos/return
PAYOS_CANCEL_URL=https://your-domain.com/billing/v1/payos/cancel
PAYOS_EXPIRE_MINUTES=15

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
